#!/usr/bin/env bash
set -e

unset RUSTFLAGS

cd "$PRALINOTE/app/pronote-rs"

cargo install cargo-ndk
rustup target add x86_64-linux-android

rm -rf "$PRALINOTE/app/src/main/jniLibs/x86_64"
mkdir -p "$PRALINOTE/app/src/main/jniLibs/x86_64"

cargo ndk \
    -t x86_64 \
    -o "$PRALINOTE/app/src/main/jniLibs" \
    build --release

cargo run --release --bin uniffi-bindgen -- generate \
    --library "$PRALINOTE/app/pronote-rs/target/x86_64-linux-android/release/libpronote_rs.so" \
    --language kotlin \
    --out-dir "$PRALINOTE/app/src/main/java"
