#!/usr/bin/env bash
set -e

unset RUSTFLAGS

cargo install cargo-ndk
rustup target add x86_64-linux-android

rm -rf ../src/main/jniLibs/x86_64
mkdir -p ../src/main/jniLibs/x86_64

cargo ndk \
    -t x86_64 \
    -o ../src/main/jniLibs \
    build --release

cargo run --release --bin uniffi-bindgen -- generate \
    --library target/x86_64-linux-android/release/libpronote_rs.so \
    --language kotlin \
    --out-dir ../src/main/java
