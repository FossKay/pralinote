#!/usr/bin/env bash
set -e

# I have export RUSTFLAGS='-C target-cpu=native'
unset RUSTFLAGS

cd "$PRALINOTE/app/pronote-rs"

cargo install cargo-ndk
rustup target add aarch64-linux-android x86_64-linux-android

# Remove previous generated .so
rm -rf "$PRALINOTE/app/src/main/jniLibs"
mkdir -p "$PRALINOTE/app/src/main/jniLibs"

# Build x86_64 and arm .so
cargo ndk \
    -t arm64-v8a \
    -t x86_64 \
    -o "$PRALINOTE/app/src/main/jniLibs" \
    build --release

# Generated kt code is architecture-independent
cargo run --release --bin uniffi-bindgen -- generate \
    --library "$PRALINOTE/app/pronote-rs/target/aarch64-linux-android/release/libpronote_rs.so" \
    --language kotlin \
    --out-dir "$PRALINOTE/app/src/main/java"
