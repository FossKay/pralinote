#!/usr/bin/python

from pathlib import Path
import shutil
import os

A = Path(os.getenv("PRONOTE_RS")) / "src"
B = Path(__file__).resolve().parent / "src"

files = ["client.rs", "helpers.rs", "communication.rs", "data.rs", "encryption.rs"]

for file in files:
    shutil.copy(A/file, B/file)

data = B / "data.rs"
content = data.read_text()

content = "use uniffi::{Enum, Record};\n" + content
content = content.replace(")]\npub struct", ", Record)]\npub struct")
content = content.replace(")]\npub enum", ", Enum)]\npub enum")

shutil.rmtree(B / "../resp", ignore_errors=True)
shutil.copytree(A / "../resp", B / "../resp")

data.write_text(content)
